set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_VERSION 9)
set(CMAKE_SYSTEM_PROCESSOR amd64)
set(CMAKE_C_COMPILER "$ENV{OPENPROSPERO_CLANG}")
set(CMAKE_CXX_COMPILER "$ENV{OPENPROSPERO_CLANGXX}")
set(CMAKE_C_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_CXX_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_ASM_COMPILER "$ENV{OPENPROSPERO_CLANG}")
set(CMAKE_ASM_COMPILER_TARGET x86_64-sie-ps5)
set(CMAKE_AR "$ENV{OPENPROSPERO_AR}")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_SKIP_RPATH TRUE)
set(CMAKE_FIND_ROOT_PATH "$ENV{OPENPROSPERO_SDK}/target/cxx" "$ENV{OPENPROSPERO_SDK}/target")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
execute_process(COMMAND "$ENV{OPENPROSPERO_CLANG}" -print-resource-dir OUTPUT_VARIABLE ZD_RESOURCE OUTPUT_STRIP_TRAILING_WHITESPACE)
set(ZD_ABI_FLAGS "-I${CMAKE_CURRENT_LIST_DIR}/../core/compat -ffreestanding -fPIC -femulated-tls -fstack-protector-strong -ffunction-sections -fdata-sections -nostdinc -isystem $ENV{OPENPROSPERO_SDK}/target/cxx/include -isystem ${ZD_RESOURCE}/include -isystem $ENV{OPENPROSPERO_SDK}/target/include")
set(CMAKE_C_FLAGS_INIT "${ZD_ABI_FLAGS}")
set(CMAKE_ASM_FLAGS_INIT "${ZD_ABI_FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "-isystem $ENV{OPENPROSPERO_SDK}/target/cxx/include/c++/v1 ${ZD_ABI_FLAGS} -fexceptions -mcx16 -msse4.1")
# Clang's PS5 driver deliberately has no executable linker. Configure-time
# checks use the actual strict application linker, with its ordinary CRT.
set(CMAKE_C_LINK_EXECUTABLE "\"$ENV{OPENPROSPERO_ROOT}/build/bin/prospero-link\" --profile application --sdk-root \"$ENV{OPENPROSPERO_SDK}\" --lld \"$ENV{OPENPROSPERO_LLD}\" --no-companion -- <LINK_FLAGS> -o <TARGET> <OBJECTS> <LINK_LIBRARIES>")
set(CMAKE_CXX_LINK_EXECUTABLE "${CMAKE_C_LINK_EXECUTABLE} -lc++ -lc++abi -lunwind")
